# SHANKPIT-460 fill bots — user-level systemd unit (no sudo required)
#
# Keeps a small pool of emily-bots permanently queued into the live
# shankpit460 game server (127.0.0.1:6969) so there's always real combat
# happening, until real players are on. `-duration` is set absurdly long
# (10 years) since emily-bot is fundamentally a bounded-duration test
# harness, not a persistent daemon by design; Restart=always is the real
# safety net if the server restarts, a bot's connection drops, or it ever
# does hit that duration cap.
#
# Bot count (S170-83, "operational parity" with REDGARDEN's persistent bot
# pool): bumped from 1 to 6, then 6 to 9 (2026-08-04, founder: "the client
# will boot into matchmaking directly - first into the bot pool" -> "have
# the bot games be like 10 players so the bot pool should be 9" -- a real
# player + 9 bots = a real 10-player match). Free-for-all deathmatch, not
# team-based (see docs2/NORTHSTAR.md).
#
# Deploy:
#   cp ops/systemd/shankpit460-emily-bot.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now shankpit460-emily-bot.service
#
# Ticket secret comes from EnvironmentFile ($SHANKPIT_TICKET_SECRET) rather
# than a CLI flag — emily-bot's -ticket-secret flag defaults to that env var
# already, and passing secrets as flags leaks them into `ps`/`systemctl
# status` output in plaintext.
#
# Added 2026-07-19. Bot count bumped 2026-07-24 (S170-83), 2026-08-04 (10-player games).

[Unit]
Description=SHANKPIT-460 emily-bot fill players (keeps a bot pool queued for opponents)
After=network-online.target shankpit460-server.service
Wants=shankpit460-server.service

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/shankpit-460
EnvironmentFile=/home/fatbaby/.config/iduna/env
ExecStart=/home/fatbaby/shankpit-460/bin/emily-bot \
    -host 127.0.0.1 \
    -port 6969 \
    -bots 9 \
    -duration 87600h
Restart=always
RestartSec=10s
StandardOutput=append:/home/fatbaby/shankpit-460/var/logs/emily-bot-daemon.log
StandardError=append:/home/fatbaby/shankpit-460/var/logs/emily-bot-daemon.log
MemoryMax=128M

[Install]
WantedBy=default.target
